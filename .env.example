# Production: use PostgreSQL. Generate independent random passwords and a 32+ character secret.
APP_URL=https://operix.example.internal
SESSION_SECRET=
DATABASE_URL=postgresql://operix:CHANGE_ME@db:5432/operix
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=0
UPLOAD_DIR=/app/storage/uploads
# Local verification only: npm run setup:local
# OPERIX_EMBEDDED=1
# PGLITE_PATH=.data/operix

# Independent key and durable access-log storage; forward signed journals off-host.
SECURITY_LOG_KEY=
SECURITY_LOG_DIR=/app/storage/security
TRUST_PROXY_HEADERS=1
SESSION_IDLE_MINUTES=30
FILE_SCAN_MODE=clamav
CLAMD_HOST=scanner
CLAMD_PORT=3310
UPLOAD_STORAGE_LIMIT_MB=10240
WORKER_REQUIRED=1
# Enable only after installing the backup timer and testing its recipient/key.
BACKUP_REQUIRED=0
BACKUP_MAX_AGE_HOURS=26
