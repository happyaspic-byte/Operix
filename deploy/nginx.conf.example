# Replace server_name and certificate paths with your internal DNS/TLS configuration.
server {
    listen 443 ssl;
    server_name operix.example.internal;
    ssl_certificate /etc/ssl/operix/fullchain.pem;
    ssl_certificate_key /etc/ssl/operix/privkey.pem;
    client_max_body_size 21m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
    }
}
