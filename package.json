{
  "name": "operix",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "jobs:run": "node --env-file-if-exists=.env --import tsx scripts/worker.ts --once",
    "lint": "oxlint src scripts tests e2e --deny correctness --max-warnings 0",
    "format:check": "prettier --check src scripts tests e2e .github *.ts *.json *.yaml"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "exceljs": "4.4.0",
    "iron-session": "9.0.1",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.41.1",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
