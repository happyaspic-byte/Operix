{
  "name": "operix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "jobs:run": "node --env-file-if-exists=.env --import tsx scripts/worker.ts --once"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/noto-sans-kr": "5.3.0",
    "exceljs": "4.4.0",
    "iron-session": "9.0.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@sparticuz/chromium": "149.0.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "agent-browser": "0.36.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
